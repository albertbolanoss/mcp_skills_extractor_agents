# --- labs_agent_lib.AgentSettings ---
# Required by every extraction tool's Claude Agent SDK call (extract_technical_skills,
# extract_soft_skills, extract_certifications, extract_languages all go through this).
LABS_AGENT_LIB_PROVIDER=portkey
LABS_AGENT_LIB_LOG_LEVEL=INFO
LABS_AGENT_LIB_DISABLE_PROMPT_CACHING=false

# Portkey (used when LABS_AGENT_LIB_PROVIDER=portkey, the default).
LABS_AGENT_LIB_PORTKEY_BASE_URL=https://portkeygateway.perficient.com
LABS_AGENT_LIB_PORTKEY_API_KEY=
# Portkey provider/credential alias (e.g. "aws-bedrock-use2") - optional.
LABS_AGENT_LIB_PORTKEY_VIRTUAL=

# Anthropic direct (used when LABS_AGENT_LIB_PROVIDER=anthropic).
LABS_AGENT_LIB_ANTHROPIC_BASE_URL=https://api.anthropic.com
LABS_AGENT_LIB_ANTHROPIC_API_KEY=

# --- mcp_skills_extractor_agents.settings.SkillAgentSettings ---
# Optional. Comma-separated list restricting the server to only these tools. Unset (the
# default) registers all 4: extract_technical_skills, extract_soft_skills,
# extract_certifications, extract_languages.
# CANDIDATE_SKILL_AGENT_ACTIVE_TOOLS=
